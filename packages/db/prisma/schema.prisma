generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  apiKeys   ApiKey[]
  events    Event[]
  incidents Incident[]
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  hashedKey      String       @unique
  label          String
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?
}

model Event {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  sourceType      String
  integrationId   String           @default("unknown")
  actorId         String?
  resourceId      String?
  actionType      String
  actionCategory  String           @default("unknown")
  actionTarget    String?
  requestId       String?
  sourceIp        String?
  userAgent       String?
  outcomeStatus   String
  confidence      Float
  payload         Json
  timestamp       DateTime
  ingestedAt      DateTime         @default(now())
  detectionLinks  DetectionEvent[]

  @@index([organizationId, timestamp])
  @@index([organizationId, actionCategory, outcomeStatus, ingestedAt])
  @@index([organizationId, actorId, ingestedAt])
}

model Detection {
  id            String           @id @default(uuid())
  ruleId        String
  evidenceLevel String
  description   String
  incidentId    String?
  incident      Incident?        @relation(fields: [incidentId], references: [id])
  createdAt     DateTime         @default(now())
  sourceEvents  DetectionEvent[]
}

model DetectionEvent {
  detectionId String
  detection   Detection @relation(fields: [detectionId], references: [id])
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id])

  @@id([detectionId, eventId])
}

model Incident {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  detections     Detection[]
  createdAt      DateTime     @default(now())
}
